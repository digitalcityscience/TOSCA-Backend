{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tosca.digitalcityscience.de/schemas/geosimulations/package-manifest-v1.schema.json",
  "title": "TOSCA simulation package manifest, format v1",
  "description": "manifest.json at the root of a TOSCA simulation package. Producers write it; TOSCA validates it before importing anything. Unknown top-level and per-output fields are allowed and stored for provenance; unknown output kinds are rejected. Rules a schema cannot express (unique roles, files on disk, checksums, timezone names, time order) are checked by tosca_api.apps.geosimulations.packages.",
  "type": "object",
  "required": ["format", "format_version", "model", "run", "outputs", "files"],
  "properties": {
    "format": { "const": "tosca-simulation-package" },
    "format_version": { "const": 1 },
    "model": {
      "type": "object",
      "required": ["key", "version", "title"],
      "properties": {
        "key": { "$ref": "#/$defs/slug", "maxLength": 100 },
        "version": { "type": "string", "minLength": 1, "maxLength": 50 },
        "title": { "$ref": "#/$defs/title" },
        "source_revision": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["commit"],
              "properties": {
                "commit": { "type": "string", "minLength": 1 },
                "dirty": { "type": "boolean" }
              }
            }
          ]
        }
      }
    },
    "run": {
      "type": "object",
      "required": ["key", "title", "parameters", "time"],
      "properties": {
        "key": { "$ref": "#/$defs/slug", "maxLength": 200 },
        "title": { "$ref": "#/$defs/title" },
        "created_at": { "type": "string", "minLength": 1 },
        "seed": { "type": ["integer", "null"] },
        "parameters": { "type": "object" },
        "time": {
          "type": "object",
          "required": ["start", "end", "timezone"],
          "properties": {
            "start": { "type": "string", "minLength": 1 },
            "end": { "type": "string", "minLength": 1 },
            "timezone": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        "bounds": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/output" }
    },
    "labels": {
      "description": "Display labels for categorical attribute values: {attribute: {value: {language: label}}}.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "files": {
      "description": "Checksum of every file in the package except manifest.json.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/package_path" },
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "provenance": { "type": "object" }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 255 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "package_path": {
      "description": "Relative POSIX path inside the package; no absolute paths, backslashes, or '..' segments.",
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[A-Za-z0-9._/-]+$"
    },
    "output": {
      "type": "object",
      "required": ["role", "kind", "title", "path"],
      "properties": {
        "role": { "$ref": "#/$defs/slug", "maxLength": 100 },
        "kind": { "enum": ["vector_layer", "trips", "table", "image"] },
        "title": { "$ref": "#/$defs/title" },
        "path": { "$ref": "#/$defs/package_path" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "vector_layer" } } },
          "then": {
            "required": ["layer", "geometry_type", "srid"],
            "properties": {
              "path": { "pattern": "\\.gpkg$" },
              "layer": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 63 },
              "geometry_type": {
                "enum": [
                  "Point", "LineString", "Polygon",
                  "MultiPoint", "MultiLineString", "MultiPolygon"
                ]
              },
              "srid": { "type": "integer", "minimum": 1 },
              "features": { "type": "integer", "minimum": 0 },
              "style_hint": { "type": ["string", "null"] }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "trips" } } },
          "then": {
            "required": ["encoding", "encoding_version"],
            "properties": {
              "path": { "pattern": "\\.json\\.gz$" },
              "encoding": { "const": "tosca-trips" },
              "encoding_version": { "const": 1 },
              "agents": { "type": "integer", "minimum": 0 },
              "size_bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "table" } } },
          "then": { "properties": { "path": { "pattern": "\\.csv$" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "image" } } },
          "then": { "properties": { "path": { "pattern": "\\.(png|jpe?g|webp)$" } } }
        }
      ]
    }
  }
}
