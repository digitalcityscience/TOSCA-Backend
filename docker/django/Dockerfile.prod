FROM python:3.14-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV UV_PROJECT_ENVIRONMENT=/venv

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    bash \
    curl \
    git \
    gosu \
    gdal-bin \
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock README.md ./
COPY manage.py ./
COPY tosca_api ./tosca_api
COPY templates ./templates
COPY scripts ./scripts
COPY docker/django ./docker/django
COPY static ./static

RUN uv sync --frozen --no-dev

RUN useradd -m -r -u 10001 appuser \
    && chown -R appuser:appuser /app /venv

# Set by `make image` and by the release workflow; a plain `docker build` gives
# a "dev" image. Kept after the dependency layers so a new version does not
# reinstall them.
ARG VERSION=dev
ARG REVISION=unknown
ENV TOSCA_BACKEND_VERSION=${VERSION} \
    TOSCA_BACKEND_REVISION=${REVISION}
LABEL org.opencontainers.image.title="tosca-backend" \
      org.opencontainers.image.source="https://github.com/digitalcityscience/TOSCA-Backend" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"

EXPOSE 8000

ENTRYPOINT ["bash", "docker/django/entrypoint.prod.sh"]
CMD ["/venv/bin/gunicorn", "--bind", "0.0.0.0:8000", "--workers", "3", "--threads", "2", "--timeout", "120", "tosca_api.wsgi:application"]
